<?xml version="1.0" encoding="utf-8"?>
<!-- While msfp-dotnet 0.4.0-preview isn't on nuget.org: its packages, packed
     locally beside this repository (../msfp-dotnet/artifacts/packages).
     Removed once they are published. -->
<configuration>
  <packageSources>
    <add key="msfp-local" value="../msfp-dotnet/artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
