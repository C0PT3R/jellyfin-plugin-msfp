<Project Sdk="Microsoft.NET.Sdk">
  <!-- MSFP, the protocol alone: no Jellyfin, MediaBrowser or ASP.NET
       reference, so that it can become a library of its own. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Msfp</RootNamespace>
    <AssemblyName>Msfp</AssemblyName>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ed25519: .NET has none of its own. Fully managed, so it runs
         wherever .NET runs. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
</Project>
