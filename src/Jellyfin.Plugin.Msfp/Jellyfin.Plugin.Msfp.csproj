<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Msfp</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Msfp</AssemblyName>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <!-- Copy package DLLs (BouncyCastle) next to the plugin's on build, so
         the output folder is the plugin as Jellyfin loads it (the engine's
         DLLs, project references, are copied anyway). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- msfp-dotnet, the MSFP engine, checked out beside this repository
         (github.com/msfp-io/msfp-dotnet); another place with
         -p:MsfpDotnet=<path>. -->
    <MsfpDotnet Condition="'$(MsfpDotnet)' == ''">$(MSBuildThisFileDirectory)../../../msfp-dotnet</MsfpDotnet>
  </PropertyGroup>
  <ItemGroup>
    <!-- Jellyfin's own, at the version of the Jellyfin it's built for;
         Jellyfin provides them at run time. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- MSFP itself: the engine and the protocol (Msfp.Engine.dll,
         Msfp.Protocol.dll), with their Ed25519 (BouncyCastle); all three
         shipped with the plugin. -->
    <ProjectReference Include="$(MsfpDotnet)/src/Msfp.Engine/Msfp.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Msfp.Tests" />
  </ItemGroup>
</Project>
