<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Msfp</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Msfp</AssemblyName>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <!-- Copy package DLLs (MSFP, BouncyCastle) next to the plugin's on
         build, so the output folder is the plugin as Jellyfin loads it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Jellyfin's own, at the version of the Jellyfin it's built for;
         Jellyfin provides them at run time. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" ExcludeAssets="runtime" />
    <!-- Jellyfin's own image library (12.2 ships 3.119.4), for paired
         servers' preview sheets: never shipped with the plugin. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" ExcludeAssets="runtime;native" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- MSFP itself, msfp-dotnet's packages (github.com/msfp-io/msfp-dotnet):
         the engine, which brings the protocol (Msfp.Engine.dll,
         Msfp.Protocol.dll) and their Ed25519 (BouncyCastle); all three
         shipped with the plugin. -->
    <PackageReference Include="Msfp.Engine" Version="0.2.0-preview" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Msfp.Tests" />
  </ItemGroup>
</Project>
